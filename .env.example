# Copy to .env for local runs (npm start). On Vercel, set these in Project Settings → Environment Variables.
# No AI keys: speech to text and the coach model run in the browser.
# Passcode for the app itself. Use something long.
APP_PASSCODE=
# Optional. Signs the login and recap cookies. Without it the key is derived from the passcode.
# SESSION_SECRET=
# Vercel sets BLOB_READ_WRITE_TOKEN when you connect a private Blob store. Leave empty locally to use ./sessions and ./data.
