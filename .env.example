# Copy to .env for local runs (npm start). On Vercel, set these in Project Settings → Environment Variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Passcode for the app itself. Use something long; it unlocks your API keys.
APP_PASSCODE=
# Signs the login and recap cookies. 32+ random characters: openssl rand -base64 48
# SESSION_SECRET=   (optional: cookie key; derived from APP_PASSCODE if unset)
# Vercel sets BLOB_READ_WRITE_TOKEN when you connect a private Blob store. Leave empty locally to use ./sessions and ./data.
